# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra allowed origins, e.g. https://heyzono.com,https://www.heyzono.com
FRONTEND_URLS=

# Database
DATABASE_URL=postgresql://ridespot:ridespot_dev@localhost:5432/ridespot

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ridespot.app

# External APIs
TICKETMASTER_API_KEY=
EVENTBRITE_API_KEY=
EVENTBRITE_OFFICIAL_DISCOVERY_ENABLED=true
EVENTBRITE_PUBLIC_SCRAPER_ENABLED=true
EVENTBRITE_SCRAPER_USER_AGENT=RideSpotBot/1.0 (+https://heyzono.com)
# Crawls Eventbrite's public sitemap (event detail pages) since the official Discovery
# Search API is closed to non-partner keys for most accounts -- see
# backend/src/services/eventbriteSitemap.service.ts.
EVENTBRITE_SITEMAP_CRAWL_ENABLED=true
EVENTBRITE_SITEMAP_MAX_EVENT_PAGES_PER_CYCLE=3000
EVENT_AGGREGATOR_PROVIDER=
EVENT_AGGREGATOR_API_KEY=
PUBLIC_EVENT_REFRESH_TTL_SECONDS=600
GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_API_KEY=
HERE_MAPS_API_KEY=
# Overpass (OpenStreetMap) endpoint used for the bulk, free restaurant-venue pull that feeds
# delivery hotspots. Leave blank to use the public overpass-api.de instance.
OVERPASS_API_URL=

# ML Service
# Confirmed live and schema-matching as of 2026-08-23 -- see backend/src/services/ml.service.ts.
ML_SERVICE_URL=https://ridespot-production.up.railway.app
GROQ_API_KEY=
GROQ_OCR_MODEL=llama-3.3-70b-versatile
ADMIN_OCR_MAX_IMAGE_MB=8

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payments
# Flutterwave V4 OAuth credentials from the dashboard.
FLUTTERWAVE_ENV=live
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
# Required only when using Flutterwave V4 direct charge. This must be enabled on your merchant account.
# Do not set this to "opay" unless Flutterwave has enabled Opay for your merchant.
FLUTTERWAVE_PAYMENT_METHOD=
# Flutterwave dashboard webhook "Secret hash". Use the same value in Flutterwave and here.
FLUTTERWAVE_WEBHOOK_SECRET=
# Optional hosted Standard Checkout secret. If set to a FLWSECK... value, RideSpot prefers hosted checkout.
FLUTTERWAVE_SECRET_KEY=
# Optional recurring plan ids if you create Flutterwave payment plans.
FLUTTERWAVE_PRO_PLAN_ID_NG=
FLUTTERWAVE_FLEET_PLAN_ID_NG=
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Optional only if you later enable SumUp webhooks. Current SumUp flow polls checkout status.
SUMUP_WEBHOOK_SECRET=
BACKEND_PUBLIC_URL=http://localhost:4000
PAYMENT_SUCCESS_URL=http://localhost:3000/app/profile
PAYMENT_CANCEL_URL=http://localhost:3000/app/profile
