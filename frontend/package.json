{
  "name": "ridespot-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "dev:detached": "node scripts/start-next-detached.mjs",
    "start:detached": "node scripts/start-next-prod-detached.mjs",
    "backend:dev": "npm --prefix backend run dev",
    "backend:worker": "npm --prefix backend run dev:worker",
    "backend:build": "npm --prefix backend run build",
    "backend:start:detached": "npm --prefix backend run start:detached",
    "ml:health": "node scripts/check-ml-health.mjs 8010 127.0.0.1 30000",
    "ml:smoke": "python ml-service/scripts/smoke_service.py",
    "ml:smoke:remote": "python ml-service/scripts/smoke_remote.py",
    "ml:proxy:sample": "python ml-service/scripts/build_proxy_outcomes.py --limit 1000 --timeout 20 --allow-fixture",
    "ml:proxy:experiment": "python ml-service/scripts/run_proxy_experiment.py --max-rows 6000 --no-promote",
    "ml:operating-policy": "python ml-service/scripts/evaluate_operating_policy.py --target-accuracy 0.98",
    "ml:proxy:binary-policy": "python ml-service/scripts/evaluate_proxy_binary_policy.py --proxy-path ml-service/src/data/proxy/proxy_frostt_full.csv",
    "build": "node scripts/build-next-bounded.mjs",
    "start": "node scripts/run-next.mjs start",
    "smoke:frontend": "node scripts/smoke-next-routes.mjs",
    "check:tailwind": "node scripts/check-tailwind-entry.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.1.0",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hookform/resolvers": "^3.9.1",
    "@react-google-maps/api": "^2.20.5",
    "axios": "^1.8.4",
    "clsx": "^2.1.1",
    "firebase": "^11.6.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.511.0",
    "next": "^14.2.30",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-phone-input-2": "^2.15.1",
    "recharts": "^2.15.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "workbox-window": "^7.3.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.5.3",
    "sharp": "^0.34.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
